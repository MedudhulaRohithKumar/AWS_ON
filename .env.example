# CSR — Lambda Environment Variables
# Copy these into your Lambda function's environment configuration.
# Never commit real values to source control.

# ─── Required ──────────────────────────────────────────────────
S3_BUCKET_NAME=instance-rds-extend
AWS_REGION=ap-south-1
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

# ─── EventBridge Scheduler (for auto-stop) ─────────────────────
# Get CSR_LAMBDA_ARN from Lambda console after first deploy
CSR_LAMBDA_ARN=arn:aws:lambda:ap-south-1:YOUR_ACCOUNT_ID:function:csr-backend

# IAM role that EventBridge Scheduler uses to invoke the Lambda
SCHEDULER_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/csr-scheduler-invoke-role

# ─── CORS ──────────────────────────────────────────────────────
# Your S3 static site URL (or custom domain). Use * for testing only.
ALLOWED_ORIGINS=https://instance-rds-extend.s3-website.ap-south-1.amazonaws.com

# ─── Optional (defaults shown) ─────────────────────────────────
UAT_TAG_KEY=TURN_UP
UAT_TAG_VALUE=UAT_EXTEND
